# Line endings: text files normalised to LF in the repository; scripts that run on Linux must stay LF on every checkout.
* text=auto
*.sh text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
deploy/Caddyfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
