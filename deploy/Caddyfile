# Reverse proxy in front of the app.
#   SITE_ADDRESS=shop.example.com  -> Caddy obtains and renews a free HTTPS certificate automatically
#   SITE_ADDRESS=:80               -> plain HTTP on the server's IP address (no certificate possible without a domain)
{$SITE_ADDRESS} {
	encode gzip
	reverse_proxy app:8080
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
