# Copy to .env and edit. Never commit .env.

# Database password (letters and digits, 20+ characters). Used by the app, the database and the backup job.
APP_DB_PASSWORD=change-me-to-a-long-random-password

# Secret that signs the "keep me signed in" cookie. Any long random string.
APP_REMEMBER_ME_KEY=change-me-to-another-long-random-string

# Where the shop reaches the server:
#   a domain name  -> automatic free HTTPS (recommended), e.g. SITE_ADDRESS=theotech.duckdns.org
#   :80            -> plain HTTP on the server IP, e.g. http://123.45.67.89
SITE_ADDRESS=:80

# true when SITE_ADDRESS is a domain (HTTPS). Must be false for plain http://<ip>, or sign-in will not stick.
APP_COOKIE_SECURE=false

# How many daily database backups to keep in ./backups
BACKUP_KEEP_DAYS=30

TZ=Africa/Kigali
